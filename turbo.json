{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "AGE_VERIFICATION_PROVIDER",
        "AI_CHAT_ENABLED",
        "AI_KNOWLEDGE_ENABLED",
        "AI_KNOWLEDGE_SYNTHETIC_FIXTURES_ENABLED",
        "AI_KNOWLEDGE_RETRIEVAL_TIMEOUT_MS",
        "AI_KNOWLEDGE_CONTEXT_TOKEN_BUDGET",
        "AI_CONTEXT_MAX_MESSAGES",
        "AI_MESSAGE_MAX_CHARACTERS",
        "AI_SEGMENT_MAX_CHARACTERS",
        "AI_SEGMENT_MAX_WAIT_MS",
        "APP_ENV",
        "DATABASE_URL",
        "FREE_DAILY_AI_LIMIT",
        "INCOGNITO_CONTEXT_TTL_SECONDS",
        "LLM_API_KEY",
        "LLM_BASE_URL",
        "LLM_CONTEXT_TOKEN_BUDGET",
        "LLM_FIRST_TOKEN_TIMEOUT_MS",
        "LLM_LEASE_SAFETY_MARGIN_MS",
        "LLM_MAX_OUTPUT_TOKENS",
        "LLM_MODEL",
        "LLM_PROVIDER",
        "LLM_STREAM_IDLE_TIMEOUT_MS",
        "LLM_TOTAL_TIMEOUT_MS",
        "LOG_LEVEL",
        "QUOTA_TIME_ZONE",
        "REQUIRED_PRIVACY_VERSION",
        "REQUIRED_TERMS_VERSION",
        "SESSION_TTL_SECONDS",
        "TEST_DATABASE_URL",
        "WEB_ORIGINS"
      ]
    }
  }
}
