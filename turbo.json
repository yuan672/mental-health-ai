{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "AGE_VERIFICATION_PROVIDER",
        "APP_ENV",
        "DATABASE_URL",
        "LOG_LEVEL",
        "REQUIRED_PRIVACY_VERSION",
        "REQUIRED_TERMS_VERSION",
        "SESSION_TTL_SECONDS",
        "TEST_DATABASE_URL",
        "WEB_ORIGINS"
      ]
    }
  }
}
