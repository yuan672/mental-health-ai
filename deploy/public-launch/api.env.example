# TEMPLATE ONLY. Not a public-launch approval. No real secrets belong in Git.
# Install a completed copy outside the release tree with owner-only permissions.
APP_ENV=production
NODE_ENV=production
APP_PORT=3001
APP_HOST=127.0.0.1
WEB_ORIGINS=https://REPLACE_DOMAIN.invalid
ADMIN_WEB_ORIGINS=https://REPLACE_ADMIN_DOMAIN.invalid
LOG_LEVEL=info

# Intentionally incomplete. PostgreSQL is provisioned separately on a private
# interface; credentials and TLS settings depend on the selected hosting service.
DATABASE_URL=
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=30000
SESSION_TTL_SECONDS=604800
AGE_VERIFICATION_PROVIDER=unconfigured
REQUIRED_TERMS_VERSION=REPLACE_AFTER_DOCUMENT_REVIEW
REQUIRED_PRIVACY_VERSION=REPLACE_AFTER_DOCUMENT_REVIEW

# These values require a real operating decision; local demo values are not policy.
FREE_DAILY_AI_LIMIT=
QUOTA_TIME_ZONE=Asia/Shanghai
RISK_EVENT_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=

# Existing gates stay closed. Registration also stays unavailable without a real
# age provider and eligible documents. Do not change APP_ENV to bypass these gates.
ACCOUNT_DELETION_ENABLED=false
ADMIN_AUTH_ENABLED=false
AI_CHAT_ENABLED=false
AI_KNOWLEDGE_ENABLED=false
AI_KNOWLEDGE_SYNTHETIC_FIXTURES_ENABLED=false
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.siliconflow.cn/v1
SAFETY_PROVIDER_PRIVACY_APPROVED=false
SAFETY_CONSENT_APPROVED=false
SAFETY_REVIEWER_ACCESS_READY=false
SAFETY_CORPUS_REVIEWED=false
HTTP_RATE_LIMIT_CAPACITY_SCALE=1

# Existing non-secret limits use the application's defaults. In particular,
# LLM_TOTAL_TIMEOUT_MS defaults to 120000; the proxy timeout below is 180 seconds.
