{
  "name": "@mental-health/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @mental-health/database build",
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @mental-health/database build",
    "test": "jest --runInBand",
    "cleanup:conversations": "pnpm run build && node dist/src/commands/purge-conversations.js",
    "cleanup:safety": "pnpm run build && node dist/src/commands/purge-safety-data.js"
  },
  "dependencies": {
    "@mental-health/database": "workspace:*",
    "@mental-health/types": "workspace:*",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-express": "11.1.24",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "nestjs-pino": "5.1.0",
    "pino": "10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.24",
    "@types/express": "^5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "29.7.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.1",
    "typescript": "5.9.3"
  }
}
