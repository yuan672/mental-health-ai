# Runtime
APP_ENV=development
APP_PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
LOG_LEVEL=info

# PostgreSQL - local development placeholders only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mental_health_dev
POSTGRES_USER=mental_health
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://mental_health:change-me-local-only@localhost:5432/mental_health_dev

# Authentication (Phase 2; generate a strong value outside Git)
SESSION_SECRET=

# LLM (Phase 3; keep provider credentials backend-only)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=

# Optional future infrastructure. Redis is not required in Phase 1.
REDIS_URL=
