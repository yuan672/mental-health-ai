# Runtime
APP_ENV=development
APP_PORT=3001
WEB_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3001
LOG_LEVEL=info

# PostgreSQL - local development placeholders only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mental_health_dev
POSTGRES_USER=mental_health
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://mental_health:change-me-local-only@localhost:5432/mental_health_dev
TEST_DATABASE_URL=postgresql://mental_health:change-me-local-only@localhost:5432/mental_health_test

# Identity and access - Mock age verification is development/test only
SESSION_TTL_SECONDS=604800
AGE_VERIFICATION_PROVIDER=mock
REQUIRED_TERMS_VERSION=1.0
REQUIRED_PRIVACY_VERSION=1.0

# Phase 2B quota policy - product limit is intentionally not decided here
FREE_DAILY_AI_LIMIT=
QUOTA_TIME_ZONE=Asia/Shanghai

# LLM (Phase 3; keep provider credentials backend-only)
AI_CHAT_ENABLED=false
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=
LLM_FIRST_TOKEN_TIMEOUT_MS=30000
LLM_STREAM_IDLE_TIMEOUT_MS=20000
LLM_TOTAL_TIMEOUT_MS=120000
LLM_LEASE_SAFETY_MARGIN_MS=5000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_TOKEN_BUDGET=6000
AI_CONTEXT_MAX_MESSAGES=20
AI_MESSAGE_MAX_CHARACTERS=4000
AI_SEGMENT_MAX_CHARACTERS=200
AI_SEGMENT_MAX_WAIT_MS=500
INCOGNITO_CONTEXT_TTL_SECONDS=1800

# Optional future infrastructure. Redis is not required in Phase 1.
REDIS_URL=
