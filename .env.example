# Runtime
APP_ENV=development
APP_PORT=3001
# Keep 0.0.0.0 for existing local/container workflows; use 127.0.0.1 behind a
# reverse proxy on the same host. A container must instead restrict its host port.
APP_HOST=0.0.0.0
WEB_ORIGINS=http://localhost:5173
ADMIN_AUTH_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_MAX_UNRESOLVED_GLOBAL=128
ACCOUNT_DELETION_TIMEOUT_MS=30000
ADMIN_WEB_ORIGINS=http://localhost:5174
STAFF_SESSION_TTL_SECONDS=28800
VITE_API_BASE_URL=http://localhost:3001
LOG_LEVEL=info
HTTP_RATE_LIMIT_KEY_TTL_SECONDS=300
HTTP_RATE_LIMIT_SWEEP_INTERVAL_SECONDS=30
HTTP_RATE_LIMIT_MAX_KEYS_PER_POLICY=1000
HTTP_RATE_LIMIT_MAX_TOTAL_KEYS=12000
HTTP_RATE_LIMIT_CAPACITY_SCALE=1
HTTP_CREDENTIAL_MAX_CONCURRENCY=4
HTTP_CREDENTIAL_OPERATION_TIMEOUT_MS=30000

# PostgreSQL - local development placeholders only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mental_health_dev
POSTGRES_USER=mental_health
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://mental_health:change-me-local-only@localhost:5432/mental_health_dev
TEST_DATABASE_URL=postgresql://mental_health:change-me-local-only@localhost:5432/mental_health_test
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=30000

# Identity and access - Mock age verification is development/test only
SESSION_TTL_SECONDS=604800
AGE_VERIFICATION_PROVIDER=mock
REQUIRED_TERMS_VERSION=1.1
REQUIRED_PRIVACY_VERSION=1.1

# Phase 2B quota policy - product limit is intentionally not decided here
FREE_DAILY_AI_LIMIT=
QUOTA_TIME_ZONE=Asia/Shanghai

# LLM (Phase 3; keep provider credentials backend-only)
AI_CHAT_ENABLED=false
AI_KNOWLEDGE_ENABLED=false
AI_KNOWLEDGE_SYNTHETIC_FIXTURES_ENABLED=false
AI_KNOWLEDGE_RETRIEVAL_TIMEOUT_MS=2000
AI_KNOWLEDGE_CONTEXT_TOKEN_BUDGET=1000
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=
LLM_FIRST_TOKEN_TIMEOUT_MS=30000
LLM_STREAM_IDLE_TIMEOUT_MS=20000
LLM_TOTAL_TIMEOUT_MS=120000
LLM_LEASE_SAFETY_MARGIN_MS=5000
LLM_MAX_OUTPUT_TOKENS=1024
LLM_CONTEXT_TOKEN_BUDGET=6000
AI_CONTEXT_MAX_MESSAGES=20
AI_MESSAGE_MAX_CHARACTERS=4000
AI_SEGMENT_MAX_CHARACTERS=200
AI_SEGMENT_MAX_WAIT_MS=500
INCOGNITO_CONTEXT_TTL_SECONDS=1800
INCOGNITO_CONTEXT_CLEANUP_INTERVAL_MS=30000
INCOGNITO_CONTEXT_MAX_GLOBAL=1000
INCOGNITO_CONTEXT_MAX_PER_USER=10
INCOGNITO_CONTEXT_MAX_PER_SESSION=3
INCOGNITO_CONTEXT_MAX_REQUESTS=20
INCOGNITO_CONTEXT_MAX_MESSAGES=40
INCOGNITO_CONTEXT_MAX_CHARACTERS=32000
INCOGNITO_CONTEXT_MAX_MESSAGE_CHARACTERS=16384
CONSENT_LOCK_MAX_WAITERS_GLOBAL=1000
CONSENT_LOCK_MAX_WAITERS_PER_USER=20
CONSENT_ACTIVE_EXECUTIONS_MAX_GLOBAL=1000
CONSENT_ACTIVE_EXECUTIONS_MAX_PER_USER=10
CONSENT_REVOKED_MARKER_MAX_GLOBAL=2000
CONSENT_REVOKED_MARKER_MAX_LIFETIME_MS=1800000
SAFETY_CONTEXT_MAX_MESSAGES=8
SAFETY_CONTEXT_TOKEN_BUDGET=2000
SAFETY_CONTEXT_MAX_CHARACTERS=6000
RISK_CLASSIFIER_MIN_CONFIDENCE=0.65
SAFETY_CLASSIFIER_TIMEOUT_MS=5000
RISK_EVENT_RETENTION_DAYS=180
# Development/test fixture only. Production policy is not decided.
AUDIT_RETENTION_DAYS=90
SAFETY_PROVIDER_PRIVACY_APPROVED=false
SAFETY_CONSENT_APPROVED=false
SAFETY_REVIEWER_ACCESS_READY=false
SAFETY_CORPUS_REVIEWED=false

# Optional future infrastructure. Redis is not required in Phase 1.
REDIS_URL=
